<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".CashieApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cashie">


        <activity
            android:name=".LoginActivity"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>


        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/setup_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:label="@string/edit_profile_title"
            android:theme="@style/Theme.Cashie" />
        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:theme="@style/Theme.Cashie" />


        <activity
            android:name=".MainActivity"
            android:exported="false" />


        <activity
            android:name=".SettingActivity"
            android:exported="false" />
        <activity android:name=".CategoryMainActivity" />

    </application>

</manifest>
