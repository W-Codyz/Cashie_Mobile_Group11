<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Quyền đọc ảnh từ bộ nhớ (dùng cho avatar) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Fallback cho Android 12 trở xuống -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />
    <!-- Ghi file xuất báo cáo PDF/Excel (Android ≤ 9) -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <application
        android:name=".CashieApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cashie"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".SplashActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ══════════════════════════════════════════
             ACTIVITIES
        ══════════════════════════════════════════ -->

        <!-- Màn hình đăng nhập -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:enabled="true" />

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:label="@string/register_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:label="@string/setup_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:label="@string/profile_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".EditProfileActivity"
            android:exported="false"
            android:label="@string/edit_profile_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".ChangePasswordActivity"
            android:exported="false"
            android:label="@string/change_password_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".SettingActivity"
            android:exported="false"
            android:label="@string/setting_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".StatsActivity"
            android:exported="false"
            android:label="@string/stats_title"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".CategoryMainActivity"
            android:exported="false" />

        <activity
            android:name=".AddTransactionActivity"
            android:exported="false"
            android:label="@string/add_transaction_title"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Cashie" />

        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:label="Thông tin ứng dụng"
            android:theme="@style/Theme.Cashie" />

