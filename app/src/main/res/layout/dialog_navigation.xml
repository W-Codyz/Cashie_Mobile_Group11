<?xml version="1.0" encoding="utf-8"?>
<!-- Panel điều hướng trượt từ trái (70% chiều rộng) -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_nav_panel">

    <!-- ══ Header gradient ══ -->
    <LinearLayout
        android:id="@+id/navHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_balance_card"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="48dp"
        android:paddingBottom="28dp">

        <!-- App logo circle -->
        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_circle_icon"
            android:backgroundTint="#33FFFFFF">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="💰"
                android:textSize="28sp" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Cashie"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@android:color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Quản lý tài chính cá nhân"
            android:textSize="13sp"
            android:textColor="#DDFFFFFF" />

    </LinearLayout>

    <!-- ══ Menu items ══ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Quản lý giao dịch -->
            <LinearLayout
                android:id="@+id/navItemTransactions"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#2022CC00"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_home"
                        android:tint="#22CC00"
                        android:contentDescription="Giao dịch" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelTransactions"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quản lý giao dịch"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <!-- Active indicator -->
                <View
                    android:id="@+id/navIndicatorTransactions"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Quản lý danh mục -->
            <LinearLayout
                android:id="@+id/navItemCategories"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#20FF8C00"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_category"
                        android:tint="#FF8C00"
                        android:contentDescription="Danh mục" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelCategories"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Quản lý danh mục"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <View
                    android:id="@+id/navIndicatorCategories"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Thống kê -->
            <LinearLayout
                android:id="@+id/navItemStats"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#202196F3"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_bar_chart"
                        android:tint="#2196F3"
                        android:contentDescription="Thống kê" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelStats"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thống kê"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <View
                    android:id="@+id/navIndicatorStats"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Hồ sơ -->
            <LinearLayout
                android:id="@+id/navItemProfile"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#209C27B0"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_person"
                        android:tint="#9C27B0"
                        android:contentDescription="Hồ sơ" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelProfile"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Hồ sơ"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <View
                    android:id="@+id/navIndicatorProfile"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Cài đặt -->
            <LinearLayout
                android:id="@+id/navItemSettings"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#20607D8B"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_settings"
                        android:tint="#607D8B"
                        android:contentDescription="Cài đặt" />
                </FrameLayout>

                <TextView
                    android:id="@+id/navLabelSettings"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cài đặt"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

                <View
                    android:id="@+id/navIndicatorSettings"
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_button_primary"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="6dp"
                android:background="@color/divider" />

            <!-- Thông tin ứng dụng -->
            <LinearLayout
                android:id="@+id/navItemAbout"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_circle_icon"
                    android:backgroundTint="#2000BCD4"
                    android:layout_marginEnd="16dp">
                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_info"
                        android:tint="#00BCD4"
                        android:contentDescription="Thông tin" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Thông tin ứng dụng"
                    android:textSize="15sp"
                    android:textColor="@color/text_primary" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- ══ Footer ══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cashie v1.0.0  ·  Nhóm 11"
        android:textSize="12sp"
        android:textColor="@color/text_muted"
        android:gravity="center"
        android:paddingTop="14dp"
        android:paddingBottom="20dp" />

</LinearLayout>
